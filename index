"}, {"category": "Gerichte & Fast Food", "name": "Cheeseburger", "kcal": 280, "portion": 200, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Chicken Nuggets", "kcal": 295, "portion": 180, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Spaghetti Bolognese", "kcal": 140, "portion": 500, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Lasagne Bolognese", "kcal": 170, "portion": 500, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Chili con Carne", "kcal": 120, "portion": 450, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Schnitzel mit Pommes", "kcal": 230, "portion": 600, "unit": "g"}, {"category": "Gerichte & Fast Food", "name": "Maultaschen mit Ei", "kcal": 180, "portion": 400, "unit": "g"}], "customFoods": [], "diary": [], "weights": []};
const STORAGE_KEY = "kalorientracker_state_v1";
let state = loadLocal();
let selectedMeal = "Frühstück";

function clone(x){return JSON.parse(JSON.stringify(x))}
function loadLocal(){
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    return raw?JSON.parse(raw):clone(DEFAULT_STATE);
  }catch(e){return clone(DEFAULT_STATE)}
}
function saveLocal(){localStorage.setItem(STORAGE_KEY,JSON.stringify(state));renderAll()}
function todayISO(){return new Date().toISOString().slice(0,10)}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function fmt(n,d=0){return Number(n||0).toLocaleString("de-DE",{minimumFractionDigits:d,maximumFractionDigits:d})}
function allFoods(){return [...state.foods,...state.customFoods]}
function categories(){return [...new Set(allFoods().map(x=>x.category).filter(Boolean))].sort((a,b)=>a.localeCompare(b,"de"))}
function getFood(){return allFoods().find(f=>f.category===dCategory.value && f.name===dFood.value)}
function calc(food,amount){return food&&amount?Number(food.kcal)*Number(amount)/100:0}

headerDate.textContent=new Date().toLocaleDateString("de-DE",{weekday:"short",day:"2-digit",month:"2-digit"});

document.querySelectorAll(".nav-btn").forEach(btn=>btn.addEventListener("click",()=>{
  document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");
  document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
  document.getElementById(btn.dataset.view).classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
}));

document.querySelectorAll(".meal-btn").forEach(btn=>btn.addEventListener("click",()=>{
  selectedMeal=btn.dataset.meal;
  document.querySelectorAll(".meal-btn").forEach(b=>b.classList.toggle("active",b===btn));
}));

function renderCategoryDropdown(){
  const current=dCategory.value;
  dCategory.innerHTML=categories().map(c=>`<option>${esc(c)}</option>`).join("");
  if([...dCategory.options].some(o=>o.value===current))dCategory.value=current;
  renderFoodDropdown();
}
function renderFoodDropdown(){
  const current=dFood.value;
  const list=allFoods().filter(f=>f.category===dCategory.value).sort((a,b)=>a.name.localeCompare(b.name,"de"));
  dFood.innerHTML=list.map(f=>`<option>${esc(f.name)}</option>`).join("");
  if([...dFood.options].some(o=>o.value===current))dFood.value=current;
  updatePreview();
}
function updatePreview(){
  const f=getFood(),amount=Number(dAmount.value||0);
  dUnit.value=f?.unit||"";
  previewPer100.textContent=f?fmt(f.kcal,1):"0";
  previewKcal.textContent=f&&amount?fmt(calc(f,amount),0):"0";
  dAmount.placeholder=f?.portion?String(f.portion):"200";
}
dCategory.addEventListener("change",renderFoodDropdown);
dFood.addEventListener("change",updatePreview);
dAmount.addEventListener("input",updatePreview);

addDiary.addEventListener("click",()=>{
  const f=getFood(),amount=Number(dAmount.value);
  if(!dDate.value||!f||!amount){alert("Bitte Datum, Lebensmittel und Menge ausfüllen.");return}
  state.diary.push({
    id:(crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random())),
    date:dDate.value,meal:selectedMeal,category:f.category,food:f.name,
    amount,unit:f.unit,kcal100:f.kcal,kcal:calc(f,amount)
  });
  dAmount.value="";
  saveLocal();
  previewKcal.textContent="0";
  document.querySelector('[data-view="dashboard"]').click();
});

function entryCard(x,withDelete=true){
  return `<div class="entry">
    <div class="entry-top">
      <div><div class="entry-name">${esc(x.food)}</div><div class="entry-meta">${esc(x.meal)} · ${esc(x.category)} · ${fmt(x.amount,0)} ${esc(x.unit)}</div></div>
      <div class="entry-kcal">${fmt(x.kcal,0)} kcal</div>
    </div>
    ${withDelete?`<div class="entry-actions"><button class="mini-btn" onclick="delDiary('${x.id}')">Löschen</button></div>`:""}
  </div>`;
}
function renderDiary(){
  const list=[...state.diary].sort((a,b)=>b.date.localeCompare(a.date));
  diaryList.innerHTML=list.length?list.map(x=>`<div class="small muted" style="margin:10px 0 5px">${x.date}</div>${entryCard(x,true)}`).join(""):'<div class="list-empty">Noch keine Einträge.</div>';
}
window.delDiary=id=>{state.diary=state.diary.filter(x=>x.id!==id);saveLocal()};

addFood.addEventListener("click",()=>{
  const category=fCategory.value.trim(),name=fName.value.trim(),kcal=Number(fKcal.value),portion=Number(fPortion.value||100),unit=fUnit.value;
  if(!category||!name||!kcal){alert("Bitte Kategorie, Lebensmittel und kcal/100 ausfüllen.");return}
  state.customFoods.push({category,name,kcal,portion,unit});
  fCategory.value="";fName.value="";fKcal.value="";fPortion.value="100";
  saveLocal();
});
function renderCustomFoods(){
  customFoodsList.innerHTML=state.customFoods.length?state.customFoods.map((f,i)=>`
    <div class="entry"><div class="entry-top"><div><div class="entry-name">${esc(f.name)}</div><div class="entry-meta">${esc(f.category)} · ${fmt(f.kcal,1)} kcal/100 · Portion ${fmt(f.portion,0)} ${esc(f.unit)}</div></div></div>
    <div class="entry-actions"><button class="mini-btn" onclick="delFood(${i})">Löschen</button></div></div>`).join(""):'<div class="list-empty">Noch keine eigenen Lebensmittel.</div>';
}
window.delFood=i=>{state.customFoods.splice(i,1);saveLocal()};

addWeight.addEventListener("click",()=>{
  const value=Number(wValue.value);
  if(!wDate.value||!value){alert("Bitte Datum und Gewicht eintragen.");return}
  state.weights.push({id:String(Date.now()+Math.random()),date:wDate.value,weight:value});
  wValue.value="";saveLocal();
});
function renderWeight(){
  const list=[...state.weights].sort((a,b)=>b.date.localeCompare(a.date));
  weightList.innerHTML=list.length?list.map(x=>`
    <div class="entry"><div class="entry-top"><div><div class="entry-name">${fmt(x.weight,1)} kg</div><div class="entry-meta">${x.date}</div></div>
    <div><button class="mini-btn" onclick="delWeight('${x.id}')">Löschen</button></div></div></div>`).join(""):'<div class="list-empty">Noch keine Gewichte.</div>';
}
window.delWeight=id=>{state.weights=state.weights.filter(x=>x.id!==id);saveLocal()};

saveSettings.addEventListener("click",()=>{
  Object.assign(state.settings,{
    age:Number(sAge.value),sex:sSex.value,heightCm:Number(sHeight.value),
    startWeightKg:Number(sStartWeight.value),targetWeightKg:Number(sTargetWeight.value),
    dailyCalorieTarget:Number(sTargetKcal.value)
  });
  saveLocal();alert("Gespeichert.");
});
function renderSettings(){
  const s=state.settings;
  sAge.value=s.age;sSex.value=s.sex;sHeight.value=s.heightCm;sStartWeight.value=s.startWeightKg;sTargetWeight.value=s.targetWeightKg;sTargetKcal.value=s.dailyCalorieTarget;
  const bmr=10*s.startWeightKg+6.25*s.heightCm-5*s.age+(s.sex==="Mann"?5:-161);
  needs.textContent=`Grundumsatz grob: ${Math.round(bmr)} kcal · sehr sitzender Gesamtbedarf grob: ${Math.round(bmr*1.2)} kcal/Tag`;
}
function renderDashboard(){
  const t=todayISO(),target=Number(state.settings.dailyCalorieTarget||0);
  const todays=state.diary.filter(x=>x.date===t);
  const eaten=todays.reduce((s,x)=>s+Number(x.kcal||0),0);
  todayKcal.textContent=fmt(eaten,0);
  targetKcal.textContent=fmt(target,0);
  remainingKcal.textContent=fmt(target-eaten,0);
  remainingKcal.className="metric-value "+(target-eaten>=0?"good":"bad");
  const p=target?Math.min(100,eaten/target*100):0;kcalBar.style.width=p+"%";
  kcalBarText.textContent=`${fmt(eaten,0)} von ${fmt(target,0)} kcal`;
  const weights=[...state.weights].sort((a,b)=>b.date.localeCompare(a.date));
  const last=weights[0]?.weight??Number(state.settings.startWeightKg);
  lastWeight.textContent=fmt(last,1);
  const start=Number(state.settings.startWeightKg),goal=Number(state.settings.targetWeightKg);
  const prog=start===goal?0:Math.max(0,Math.min(100,(start-last)/(start-goal)*100));
  weightBar.style.width=prog+"%";
  weightBarText.textContent=`${fmt(start-last,1)} kg von ${fmt(start-goal,1)} kg geschafft`;
  todayEntries.innerHTML=todays.length?todays.map(x=>entryCard(x,false)).join(""):'<div class="list-empty">Heute noch nichts eingetragen.</div>';
}

exportData.addEventListener("click",()=>{
  const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="kalorientracker-daten.json";a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
});
importFile.addEventListener("change",async e=>{
  const f=e.target.files[0];if(!f)return;
  try{
    const obj=JSON.parse(await f.text());
    if(!obj.settings||!obj.foods||!Array.isArray(obj.diary))throw new Error("Ungültige Datei");
    state=obj;saveLocal();alert("Backup importiert.");
  }catch(err){alert("Import fehlgeschlagen: "+err.message)}
  e.target.value="";
});
resetData.addEventListener("click",()=>{
  if(confirm("Wirklich alle lokalen Daten löschen?")){state=clone(DEFAULT_STATE);saveLocal()}
});

function renderAll(){renderCategoryDropdown();renderDiary();renderCustomFoods();renderWeight();renderSettings();renderDashboard()}
dDate.value=todayISO();wDate.value=todayISO();renderAll();
</script>
