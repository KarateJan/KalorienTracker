<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#0b1220">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="KalorienTracker">
<title>KalorienTracker</title>
<style>
:root{
  --bg:#0b1220;--panel:#111827;--panel2:#182234;--line:#263449;
  --text:#f8fafc;--muted:#93a4ba;--green:#10b981;--green2:#34d399;
  --red:#ef4444;--blue:#3b82f6;--shadow:0 10px 30px rgba(0,0,0,.22);
  --safe-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{background:var(--bg)}
body{
  margin:0;background:linear-gradient(180deg,#0b1220 0%,#0f172a 100%);
  color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;
  min-height:100vh;padding-bottom:calc(82px + var(--safe-bottom));
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.topbar{
  position:sticky;top:0;z-index:20;padding:calc(10px + env(safe-area-inset-top,0px)) 16px 12px;
  background:rgba(11,18,32,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)
}
.brand{display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand h1{margin:0;font-size:20px;letter-spacing:-.3px}
.brand .today{font-size:12px;color:var(--muted)}
main{max-width:760px;margin:auto;padding:16px}
.view{display:none}.view.active{display:block}
.card{
  background:linear-gradient(180deg,var(--panel) 0%,#0f1828 100%);
  border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:var(--shadow);margin-bottom:14px
}
.card h2,.card h3{margin:0 0 12px}
.muted{color:var(--muted)}.small{font-size:12px}
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.metric-card{
  background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:15px;min-height:112px;
  display:flex;flex-direction:column;justify-content:space-between
}
.metric-label{font-size:13px;color:var(--muted)}
.metric-value{font-size:30px;font-weight:800;line-height:1}
.metric-unit{font-size:12px;color:var(--muted);margin-top:5px}
.good{color:var(--green2)}.bad{color:#f87171}
.progress{height:12px;background:#172033;border-radius:999px;overflow:hidden}
.progress>div{height:100%;background:linear-gradient(90deg,var(--green),var(--green2));border-radius:999px}
.section-title{font-size:14px;color:#dbeafe;margin:0 0 10px;font-weight:700}
.form-grid{display:grid;gap:12px}
.field label{display:block;font-size:12px;color:var(--muted);margin:0 0 6px 2px}
input,select,textarea{
  width:100%;min-height:52px;border:1px solid #314158;background:#0c1524;color:var(--text);
  border-radius:14px;padding:12px 14px;outline:none
}
input:focus,select:focus,textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,.14)}
input[readonly]{background:#0a1220;color:#cbd5e1}
.meal-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.meal-btn{
  min-height:46px;border:1px solid #314158;border-radius:13px;background:#0c1524;color:var(--text);
  font-weight:700;padding:10px
}
.meal-btn.active{border-color:var(--green);background:rgba(16,185,129,.15);color:#a7f3d0}
.primary{
  width:100%;min-height:54px;border:0;border-radius:15px;background:linear-gradient(180deg,#10b981,#059669);
  color:#031b14;font-weight:800;font-size:16px;padding:12px
}
.secondary{
  width:100%;min-height:50px;border:1px solid #314158;border-radius:14px;background:#162235;color:var(--text);
  font-weight:700;padding:11px
}
.danger{
  width:100%;min-height:50px;border:1px solid #7f1d1d;border-radius:14px;background:#3f1116;color:#fecaca;
  font-weight:700;padding:11px
}
.cal-preview{
  margin:12px 0 14px;padding:15px;border-radius:16px;background:rgba(16,185,129,.1);
  border:1px solid rgba(16,185,129,.3);text-align:center
}
.cal-preview .big{font-size:34px;font-weight:900;color:#6ee7b7}
.entry{
  border:1px solid var(--line);border-radius:15px;padding:13px;background:#0c1524;margin-bottom:9px
}
.entry-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.entry-name{font-weight:800}.entry-meta{font-size:12px;color:var(--muted);margin-top:5px}
.entry-kcal{font-weight:800;white-space:nowrap}
.entry-actions{display:flex;gap:8px;margin-top:10px}
.mini-btn{border:1px solid #314158;background:#172033;color:#dbeafe;border-radius:10px;padding:7px 10px;font-size:12px}
.list-empty{text-align:center;color:var(--muted);padding:18px 8px}
.bottom-nav{
  position:fixed;left:0;right:0;bottom:0;z-index:30;
  display:grid;grid-template-columns:repeat(5,1fr);gap:0;
  background:rgba(10,17,30,.97);backdrop-filter:blur(14px);
  border-top:1px solid var(--line);padding:7px 6px calc(7px + var(--safe-bottom))
}
.nav-btn{
  border:0;background:transparent;color:#7f91aa;min-height:54px;border-radius:12px;font-size:11px;font-weight:700;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:4px
}
.nav-btn .ico{font-size:20px;line-height:1}.nav-btn.active{color:#6ee7b7;background:rgba(16,185,129,.08)}
.inline{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.searchbox{position:sticky;top:73px;z-index:8;background:var(--bg);padding-bottom:10px}
hr{border:0;border-top:1px solid var(--line);margin:16px 0}
@media(min-width:700px){
  body{padding-bottom:20px}
  .bottom-nav{position:sticky;bottom:auto;top:72px;max-width:760px;margin:0 auto 14px;border:1px solid var(--line);border-radius:16px;padding:6px;grid-template-columns:repeat(5,1fr)}
  .nav-btn{flex-direction:row;font-size:13px}
  .metrics{grid-template-columns:repeat(4,1fr)}
  .form-grid.two{grid-template-columns:1fr 1fr}
  main{padding-top:8px}
}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">
    <h1>KalorienTracker</h1>
    <div class="today" id="headerDate"></div>
  </div>
</header>

<nav class="bottom-nav">
  <button class="nav-btn active" data-view="dashboard"><span class="ico">⌂</span><span>Heute</span></button>
  <button class="nav-btn" data-view="diary"><span class="ico">＋</span><span>Tagebuch</span></button>
  <button class="nav-btn" data-view="foods"><span class="ico">☷</span><span>Lebensmittel</span></button>
  <button class="nav-btn" data-view="weight"><span class="ico">◉</span><span>Gewicht</span></button>
  <button class="nav-btn" data-view="more"><span class="ico">⋯</span><span>Mehr</span></button>
</nav>

<main>
<section id="dashboard" class="view active">
  <div class="metrics">
    <div class="metric-card"><div class="metric-label">Heute gegessen</div><div><div id="todayKcal" class="metric-value">0</div><div class="metric-unit">kcal</div></div></div>
    <div class="metric-card"><div class="metric-label">Noch frei</div><div><div id="remainingKcal" class="metric-value good">0</div><div class="metric-unit">kcal</div></div></div>
    <div class="metric-card"><div class="metric-label">Tagesziel</div><div><div id="targetKcal" class="metric-value">0</div><div class="metric-unit">kcal</div></div></div>
    <div class="metric-card"><div class="metric-label">Letztes Gewicht</div><div><div id="lastWeight" class="metric-value">–</div><div class="metric-unit">kg</div></div></div>
  </div>
  <div class="card">
    <div class="section-title">Kalorien heute</div>
    <div class="progress"><div id="kcalBar" style="width:0%"></div></div>
    <div id="kcalBarText" class="muted small" style="margin-top:8px"></div>
  </div>
  <div class="card">
    <div class="section-title">Gewichtsfortschritt</div>
    <div class="progress"><div id="weightBar" style="width:0%"></div></div>
    <div id="weightBarText" class="muted small" style="margin-top:8px"></div>
  </div>
  <div class="card">
    <div class="section-title">Heute</div>
    <div id="todayEntries"></div>
  </div>
</section>

<section id="diary" class="view">
  <div class="card">
    <h2>Eintrag hinzufügen</h2>
    <div class="field"><label>Datum</label><input id="dDate" type="date"></div>
    <div style="height:10px"></div>
    <div class="field"><label>Mahlzeit</label>
      <div class="meal-grid" id="mealGrid">
        <button class="meal-btn active" data-meal="Frühstück">Frühstück</button>
        <button class="meal-btn" data-meal="Mittagessen">Mittagessen</button>
        <button class="meal-btn" data-meal="Abendessen">Abendessen</button>
        <button class="meal-btn" data-meal="Snack">Snack</button>
        <button class="meal-btn" data-meal="Getränk">Getränk</button>
        <button class="meal-btn" data-meal="Sonstiges">Sonstiges</button>
      </div>
    </div>
    <div style="height:12px"></div>
    <div class="field"><label>Kategorie</label><select id="dCategory"></select></div>
    <div style="height:10px"></div>
    <div class="field"><label>Lebensmittel</label><select id="dFood"></select></div>
    <div style="height:10px"></div>
    <div class="inline">
      <div class="field"><label>Menge</label><input id="dAmount" type="number" inputmode="decimal" min="0" step="1" placeholder="200"></div>
      <div class="field"><label>Einheit</label><input id="dUnit" readonly></div>
    </div>
    <div class="cal-preview"><div class="muted small">Dieser Eintrag</div><div class="big"><span id="previewKcal">0</span> kcal</div><div class="small muted"><span id="previewPer100">0</span> kcal / 100</div></div>
    <button class="primary" id="addDiary">Eintrag speichern</button>
  </div>
  <div class="card">
    <div class="section-title">Alle Einträge</div>
    <div id="diaryList"></div>
  </div>
</section>

<section id="foods" class="view">
  <div class="card">
    <h2>Eigenes Lebensmittel</h2>
    <div class="form-grid">
      <div class="field"><label>Kategorie</label><input id="fCategory" placeholder="z.B. Meine Snacks"></div>
      <div class="field"><label>Lebensmittel</label><input id="fName" placeholder="z.B. Proteinpudding"></div>
      <div class="inline">
        <div class="field"><label>kcal / 100</label><input id="fKcal" type="number" inputmode="decimal" step="0.1"></div>
        <div class="field"><label>Portion</label><input id="fPortion" type="number" inputmode="decimal" step="1" value="100"></div>
      </div>
      <div class="field"><label>Einheit</label><select id="fUnit"><option>g</option><option>ml</option></select></div>
      <button class="primary" id="addFood">Lebensmittel speichern</button>
    </div>
  </div>
  <div class="card">
    <div class="section-title">Eigene Lebensmittel</div>
    <div id="customFoodsList"></div>
  </div>
</section>

<section id="weight" class="view">
  <div class="card">
    <h2>Gewicht eintragen</h2>
    <div class="form-grid two">
      <div class="field"><label>Datum</label><input id="wDate" type="date"></div>
      <div class="field"><label>Gewicht kg</label><input id="wValue" type="number" inputmode="decimal" step="0.1"></div>
    </div>
    <div style="height:12px"></div>
    <button class="primary" id="addWeight">Gewicht speichern</button>
  </div>
  <div class="card"><div class="section-title">Verlauf</div><div id="weightList"></div></div>
</section>

<section id="more" class="view">
  <div class="card">
    <h2>Einstellungen</h2>
    <div class="form-grid two">
      <div class="field"><label>Alter</label><input id="sAge" type="number" inputmode="numeric"></div>
      <div class="field"><label>Geschlecht</label><select id="sSex"><option>Mann</option><option>Frau</option></select></div>
      <div class="field"><label>Größe cm</label><input id="sHeight" type="number" inputmode="numeric"></div>
      <div class="field"><label>Startgewicht kg</label><input id="sStartWeight" type="number" inputmode="decimal" step="0.1"></div>
      <div class="field"><label>Zielgewicht kg</label><input id="sTargetWeight" type="number" inputmode="decimal" step="0.1"></div>
      <div class="field"><label>Kalorienziel / Tag</label><input id="sTargetKcal" type="number" inputmode="numeric"></div>
    </div>
    <div style="height:12px"></div>
    <button class="primary" id="saveSettings">Einstellungen speichern</button>
    <p id="needs" class="muted small"></p>
  </div>

  <div class="card">
    <h2>Daten & Backup</h2>
    <p class="muted">Die Einträge werden automatisch in Chrome auf diesem iPhone gespeichert. Export ist dein zusätzliches Backup.</p>
    <div class="form-grid">
      <button class="secondary" id="exportData">Backup exportieren</button>
      <label class="secondary" for="importFile" style="display:flex;align-items:center;justify-content:center">Backup importieren</label>
      <input id="importFile" type="file" accept=".json,application/json" style="display:none">
      <button class="danger" id="resetData">Alle lokalen Daten löschen</button>
    </div>
  </div>
</section>
</main>

